# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=fastapi_auth

# JWT Secrets (Generate with: openssl rand -hex 32 OR python -c "import secrets; print(secrets.token_hex(32))")
ACCESS_TOKEN_SECRET=your_access_secret_key_here_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_secret_key_here_change_in_production

# JWT Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
# In production with HTTPS, set COOKIE_SECURE=true and COOKIE_SAMESITE=none (if cross-origin) or lax
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Environment (development / production / test)
ENVIRONMENT=development

